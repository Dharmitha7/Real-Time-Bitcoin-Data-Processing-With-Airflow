# Copy this file to .env and fill in real values. Never commit .env.

# Postgres (Airflow metadata DB)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=

# Airflow core
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:${POSTGRES_PASSWORD}@postgres/airflow
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__API__SECRET_KEY=
# Airflow 3's API server signs its internal execution-API tokens with this.
AIRFLOW__API_AUTH__JWT_SECRET=

# Airflow admin user - required, no insecure default (see README for rotation).
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_ADMIN_EMAIL=admin@example.com

# Slack alerting
SLACK_WEBHOOK_URL=

# CoinGecko (optional - free tier works without a key)
COINGECKO_API_KEY=

# AWS
AWS_DEFAULT_REGION=us-east-1
BITCOIN_S3_BUCKET=
