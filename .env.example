# Copy this file to .env and fill in real values. Never commit .env.

# Postgres (Airflow metadata DB)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=

# Airflow core
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:${POSTGRES_PASSWORD}@postgres/airflow
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__API__SECRET_KEY=
# Airflow 3's API server signs its internal execution-API tokens with this.
AIRFLOW__API_AUTH__JWT_SECRET=

# Airflow admin user. Leave AIRFLOW_ADMIN_PASSWORD blank to have a random
# password generated on first `docker compose up` - see
# `docker compose logs airflow-init` for it, and README for rotation.
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_ADMIN_EMAIL=admin@example.com

# Slack alerting. Prefer setting this via AWS Secrets Manager
# (airflow/variables/slack_webhook_url) once that's set up - see README.
SLACK_WEBHOOK_URL=

# CoinGecko (optional - free tier works without a key)
COINGECKO_API_KEY=

# AWS - short-lived credentials only, never long-lived keys committed anywhere.
# No ~/.aws mount is used; these env vars are how the containers authenticate.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
BITCOIN_S3_BUCKET=
